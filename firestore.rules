rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Familiemedlemmer: satt opp manuelt i Firebase Console, appen leser dem
    // for å tegne innloggingsskjermen. Ingen skriving fra appen.
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Ukas avhukinger og opptjeningshistorikk per medlem.
    // Alle innloggede (også anonymt) kan lese/skrive alt her: PIN-koden på
    // innloggingsskjermen er en enkel gate for søsken, ikke ekte tilgangskontroll.
    match /state/{memberId} {
      allow read, write: if request.auth != null;
    }
    match /earnings/{memberId} {
      allow read, write: if request.auth != null;
    }
  }
}
